{
  "name": "codex-liquid-glass",
  "version": "0.2.0-dev",
  "private": true,
  "type": "module",
  "description": "Codex 液态玻璃皮肤：流体背景、毛玻璃材质与连续调色",
  "license": "AGPL-3.0-only",
  "author": "SuperSgdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SuperSgdk/codex-liquid-glass.git"
  },
  "homepage": "https://github.com/SuperSgdk/codex-liquid-glass#readme",
  "bugs": {
    "url": "https://github.com/SuperSgdk/codex-liquid-glass/issues"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test tests/*.test.mjs",
    "typecheck": "tsc --project tsconfig.json",
    "check": "node scripts/check.mjs",
    "preview": "node scripts/preview.mjs",
    "skin:inspect": "node scripts/codex-skin.mjs --inspect",
    "skin:apply": "node scripts/codex-skin.mjs --apply",
    "skin:remove": "node scripts/codex-skin.mjs --remove"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
